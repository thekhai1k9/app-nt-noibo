# Sao chép thành .env rồi sửa giá trị trước khi chạy.
# Mật khẩu DB nên tạo bằng: openssl rand -hex 32 (chuỗi hex an toàn trong DATABASE_URL).
POSTGRES_USER=messaging
POSTGRES_PASSWORD=messaging
POSTGRES_DB=messaging

# BẮT BUỘC thay trước khi chạy lần đầu: openssl rand -hex 32
# Giá trị mẫu dưới đây bị từ chối khi APP_ENV=prod, nên quên đổi thì api sẽ báo lỗi ngay lúc khởi động.
JWT_SECRET=change-me-to-a-long-random-string

# dev | test | prod. Mặc định prod: api từ chối khởi động nếu JWT_SECRET là giá trị mẫu
# hoặc ngắn hơn 32 ký tự, và tắt /api/docs. Đặt dev khi phát triển cục bộ.
APP_ENV=prod

# Độc lập với APP_ENV. Phải để false cho đến khi bật HTTPS, nếu không trình duyệt
# sẽ không lưu cookie refresh token. Khi đã chạy HTTPS thì đổi thành true.
COOKIE_SECURE=false

LOG_LEVEL=INFO
