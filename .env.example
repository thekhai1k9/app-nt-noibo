# Sao chép thành .env rồi sửa giá trị trước khi chạy.
# Mật khẩu DB nên tạo bằng: openssl rand -hex 32 (chuỗi hex an toàn trong DATABASE_URL).
POSTGRES_USER=messaging
POSTGRES_PASSWORD=messaging
POSTGRES_DB=messaging

# BẮT BUỘC thay trước khi chạy lần đầu: openssl rand -hex 32
# Giá trị mẫu dưới đây bị từ chối khi APP_ENV=prod, nên quên đổi thì api sẽ báo lỗi ngay lúc khởi động.
JWT_SECRET=change-me-to-a-long-random-string

# dev | test | prod. Mặc định prod: api từ chối khởi động nếu JWT_SECRET là giá trị mẫu
# hoặc ngắn hơn 32 ký tự, và tắt /api/docs. Đặt dev khi phát triển cục bộ.
APP_ENV=prod

# Độc lập với APP_ENV. Phải để false cho đến khi bật HTTPS, nếu không trình duyệt
# sẽ không lưu cookie refresh token. Khi đã chạy HTTPS thì đổi thành true.
COOKIE_SECURE=false

LOG_LEVEL=INFO

# Tiền tố kênh Redis pub/sub của chat ("<tiền tố>:room:<id>" và "<tiền tố>:user:<id>").
# Chỉ cần đổi khi nhiều bản cài dùng chung một Redis. Mặc định: kn
# BUS_CHANNEL_PREFIX=kn

# Chu kỳ (giây) hub đối soát các WebSocket đang mở với DB (thành viên phòng, tài khoản bị khoá). Mặc định: 30
# WS_RECONCILE_SECONDS=30

# Hiện diện online: một kết nối hết hạn sau PRESENCE_TTL_SECONDS nếu không được gia hạn (mặc định 45); mỗi
# PRESENCE_SWEEP_SECONDS (mặc định 15) mỗi worker gia hạn kết nối của mình và đối soát người vừa offline/online.
# PRESENCE_TTL_SECONDS phải ít nhất gấp đôi PRESENCE_SWEEP_SECONDS.
# PRESENCE_TTL_SECONDS=45
# PRESENCE_SWEEP_SECONDS=15
# Thời gian tối đa (giây) cho một lượt phát thông báo presence của một người. Mặc định: 10
# PRESENCE_ANNOUNCE_TIMEOUT_SECONDS=10
# Thông báo OFFLINE được hoãn bấy nhiêu giây (nếu người đó nối lại kịp thì không phát gì); 0 = tắt. Mặc định: 5
# PRESENCE_OFFLINE_GRACE_SECONDS=5

# Khoảng tối thiểu (giây) giữa hai sự kiện "đang soạn tin" của một kết nối trong cùng một phòng. Mặc định: 2
# WS_TYPING_INTERVAL_SECONDS=2

# Nhóm bị admin xoá được lưu trữ (ẩn với mọi người, admin khôi phục được) rồi xoá vĩnh viễn sau số ngày này. Mặc định: 3
# ROOM_ARCHIVE_RETENTION_DAYS=3

# Chu kỳ (giây) tiến trình nền dọn các nhóm đã lưu trữ quá hạn (cũng chạy một lần lúc khởi động). Mặc định: 3600
# ROOM_PURGE_INTERVAL_SECONDS=3600
